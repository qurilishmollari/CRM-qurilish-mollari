# Railway Variables (this file is a reference; Django does not load it automatically).
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# In Railway use the PostgreSQL service reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://username:password@hostname:5432/database
# Railway public domain is added automatically; set these for custom domains.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
